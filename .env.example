# Servidor Express
PORT=3000

# PostgreSQL (Motor 1 - Relacional)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=ecommerce_db

# Redis (Motor 3 - Clave-Valor)
REDIS_URL=redis://127.0.0.1:6379

# MongoDB (Motor 2 - Documental - Integrante 2)
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce_db
